{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: ws: https: wss:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "height": 800,
        "minHeight": 600,
        "minWidth": 900,
        "title": "VPS Manager",
        "width": 1280
      }
    ]
  },
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "targets": [
      "msi"
    ]
  },
  "identifier": "id.slv.vpsmanager",
  "productName": "VPS Manager",
  "version": "1.0.1"
}
